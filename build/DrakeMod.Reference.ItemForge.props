<Project>
  <PropertyGroup>
    <_ItemForgeProj Condition="Exists('$(MSBuildThisFileDirectory)..\..\DrakesItemForge\DrakesItemForge.csproj')">$(MSBuildThisFileDirectory)..\..\DrakesItemForge\DrakesItemForge.csproj</_ItemForgeProj>
    <_ItemForgeProj Condition="'$(_ItemForgeProj)' == '' and Exists('$(MSBuildThisFileDirectory)..\DrakesItemForge\DrakesItemForge.csproj')">$(MSBuildThisFileDirectory)..\DrakesItemForge\DrakesItemForge.csproj</_ItemForgeProj>
    <ItemForgePluginFolder Condition="'$(ItemForgePluginFolder)' == ''">DrakeMods-DrakesItemForge</ItemForgePluginFolder>
    <ItemForgeDll Condition="'$(ItemForgeDll)' == '' and '$(R2ModPath)' != '' and '$(ProfileName)' != ''">$(R2ModPath)\$(ProfileName)\BepInEx\plugins\$(ItemForgePluginFolder)\DrakesItemForge.dll</ItemForgeDll>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(_ItemForgeProj)' != ''">
      <ItemGroup>
        <ProjectReference Include="$(_ItemForgeProj)">
          <Project>{A1111111-1111-4111-8111-111111111103}</Project>
          <Name>DrakesItemForge</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <When Condition="'$(ItemForgeDll)' != '' and Exists('$(ItemForgeDll)')">
      <ItemGroup>
        <Reference Include="DrakesItemForge">
          <HintPath>$(ItemForgeDll)</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <_ItemForgeReferenceMissing>true</_ItemForgeReferenceMissing>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <Target Name="VerifyItemForgeReference" BeforeTargets="ResolveReferences" Condition="'$(_ItemForgeReferenceMissing)' == 'true'">
    <Error Text="DrakesItemForge not found. Clone as a sibling, install via r2modman, or set ItemForgeDll in environment.props." />
  </Target>
</Project>
