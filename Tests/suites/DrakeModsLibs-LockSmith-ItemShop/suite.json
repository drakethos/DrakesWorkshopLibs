  "requireMods": [
    {
      "guid": "com.drakesworkshop.locksmith",
      "minVersion": "0.1.0"
    },
    {
      "guid": "com.drakesworkshop.itemshop",
      "minVersion": "0.1.0"
    }
  ],
  "configOverrides": [
    {
      "guid": "com.drakesworkshop.locksmith",
      "section": "02 Features",
      "key": "EnableChests",
      "value": "true"
    },
    {
      "guid": "com.drakesworkshop.locksmith",
      "section": "02 Features",
      "key": "EnableManagedAccess",
      "value": "true"
    },
    {
      "guid": "com.drakesworkshop.locksmith",
