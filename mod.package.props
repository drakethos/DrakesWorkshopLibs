<Project>
  <PropertyGroup>
    <!-- Thunderstore package id (zip folder: DrakeMods-DrakeModsLibs-{version}) -->
    <ThunderstoreName>DrakeModsLibs</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakeModsLibs</RootNamespace>
    <AssemblyName>DrakeModsLibs</AssemblyName>
    <Version>0.9.6</Version>
    <BepInPluginName>DrakeModsLibs</BepInPluginName>
    <BepInGuid>com.drakemods.libs</BepInGuid>
    <ModInfoClass>CustomizeLibsPlugin</ModInfoClass>
    <Description>Shared DrakeMods library for Valheim - ArtItemLoader, display patches, tags, APIs, and server config sync. Required by LockSmith and DrakesRenameit. Valheim 1.0 compatible.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesWorkshopLibs</WebsiteUrl>
    <DeployAfterTargets>ILRepacker</DeployAfterTargets>
    <!-- Only this project may ILRepack / embed ServerSync -->
    <EmbedServerSync>true</EmbedServerSync>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2333" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.29.0" />
  </ItemGroup>
</Project>
