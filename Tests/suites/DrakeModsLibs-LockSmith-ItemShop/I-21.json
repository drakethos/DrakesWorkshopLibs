{
  "name": "I-21 the Lock menu on a mailbox shows the Mail tab",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "Drake_Mailbox",
      "dz": 2.5,
      "as": "box"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "box"
      },
      "expect": true,
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Mail",
      "label": "the Mail tab is there"
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Shop",
      "exact": true,
      "expect": false,
      "label": "no Shop tab on a mailbox"
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    },
    {
      "check": "noErrors",
      "source": "DrakesItemShop"
    }
  ]
}