<Project>
  <!-- Do not add a custom MSBuild-refs target here: during Rebuild Solution each consumer would
       invoke a parallel Libs build and VS locks bin\Debug\DrakeModsLibs.dll. ProjectReference
       dependency order is enough for solution and single-.csproj builds. -->

  <Target Name="PrepareModPackageMetadata" BeforeTargets="GenerateModInfo;ResolveThunderstorePaths;WriteThunderstoreManifest">
    <PropertyGroup>
      <ThunderstoreAuthor Condition="'$(ThunderstoreAuthor)' == ''">$(CompanyName)</ThunderstoreAuthor>
      <CompanyName Condition="'$(CompanyName)' == ''">$(ThunderstoreAuthor)</CompanyName>
      <ThunderstoreName Condition="'$(ThunderstoreName)' == ''">$(AssemblyName)</ThunderstoreName>
      <AssemblyName Condition="'$(AssemblyName)' == ''">$(ThunderstoreName)</AssemblyName>
      <BepInPluginName Condition="'$(BepInPluginName)' == ''">$(ThunderstoreName)</BepInPluginName>
      <ModInfoClass Condition="'$(ModInfoClass)' == ''">$(BepInPluginClass)</ModInfoClass>
      <ModInfoNamespace Condition="'$(ModInfoNamespace)' == ''">$(RootNamespace)</ModInfoNamespace>
      <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
      <AssemblyFileVersion Condition="'$(AssemblyFileVersion)' == ''">$(AssemblyVersion)</AssemblyFileVersion>
    </PropertyGroup>
    <Error Condition="'$(Version)' == ''"
           Text="Set &lt;Version&gt; in mod.package.props (imported from Directory.Build.props)." />
  </Target>

  <Target Name="ResolveThunderstorePaths"
          BeforeTargets="WriteThunderstoreManifest"
          DependsOnTargets="PrepareModPackageMetadata">
    <PropertyGroup>
      <ThunderstoreFolder Condition="'$(ThunderstoreManifestDir)' == ''">$(ThunderstoreBasePath)\$(CompanyName)-$(ThunderstoreName)-$(Version)</ThunderstoreFolder>
      <ThunderstoreFolder Condition="'$(ThunderstoreManifestDir)' != ''">$(ThunderstoreManifestDir)</ThunderstoreFolder>
      <ZipOutput>$(ThunderstoreBasePath)\$(CompanyName)-$(ThunderstoreName)-$(Version).zip</ZipOutput>
      <ManifestPath>$(ThunderstoreFolder)\manifest.json</ManifestPath>
    </PropertyGroup>
    <Message Importance="high" Text="Thunderstore package: $(ThunderstoreFolder) (version $(Version))" />
  </Target>

  <Target Name="ComposeThunderstoreDependencies" BeforeTargets="WriteThunderstoreManifest" DependsOnTargets="PrepareModPackageMetadata">
    <ItemGroup Condition="'@(ThunderstoreDependency)' != ''">
      <_ThunderstoreDepJson Include="&quot;%(ThunderstoreDependency.Identity)&quot;" />
    </ItemGroup>
    <PropertyGroup>
      <ThunderstoreDependenciesJson Condition="'@(_ThunderstoreDepJson)' != ''">@(_ThunderstoreDepJson, ',%0d%0a        ')</ThunderstoreDependenciesJson>
      <ThunderstoreDependenciesJson Condition="'$(ThunderstoreDependenciesJson)' == ''"></ThunderstoreDependenciesJson>
    </PropertyGroup>
  </Target>

  <!-- Compile against Pfhoenix stubs locally (same surface as Thunderstore CI). Live publicized
       refs hide missing 1.0 interface slots and old Character.Message overloads. -->
  <Target Name="StageCiValheimRefs"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(UseCiValheimRefs)' == 'true' and '$(CI_SKIP_POST_BUILD)' == '' and '$(StageCiValheimRefsScript)' != '' and Exists('$(StageCiValheimRefsScript)')">
    <PropertyGroup>
      <CiValheimRoot>$(IntermediateOutputPath)ci_valheim</CiValheimRoot>
      <CiPublicized>$(CiValheimRoot)\valheim_Data\Managed\publicized_assemblies</CiPublicized>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(StageCiValheimRefsScript)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -OutRoot &quot;$(CiValheimRoot)&quot;" />
    <Warning Condition="!Exists('$(CiPublicized)\assembly_valheim_publicized.dll')"
             Text="Pfhoenix CI refs were not staged. Build is using live Valheim publicized assemblies (not Thunderstore-equivalent)." />
    <PropertyGroup Condition="Exists('$(CiPublicized)\assembly_valheim_publicized.dll')">
      <PublicizedAssembliesPath>$(CiPublicized)</PublicizedAssembliesPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(CiPublicized)\assembly_valheim_publicized.dll')">
      <Reference Remove="assembly_valheim" />
      <Reference Remove="assembly_utils" />
      <Reference Remove="assembly_guiframework" />
      <Reference Include="assembly_valheim">
        <HintPath>$(CiPublicized)\assembly_valheim_publicized.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="assembly_utils" Condition="Exists('$(CiPublicized)\assembly_utils_publicized.dll')">
        <HintPath>$(CiPublicized)\assembly_utils_publicized.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="assembly_guiframework" Condition="Exists('$(CiPublicized)\gui_framework_publicized.dll')">
        <HintPath>$(CiPublicized)\gui_framework_publicized.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
    <Message Importance="high"
             Condition="Exists('$(CiPublicized)\assembly_valheim_publicized.dll')"
             Text="Compiling against Pfhoenix CI refs (Thunderstore-equivalent), not live publicized assemblies." />
  </Target>

  <Target Name="GenerateModInfo" BeforeTargets="CoreCompile" DependsOnTargets="PrepareForBuild;PrepareModPackageMetadata">
    <PropertyGroup>
      <_ModInfoContent>// &lt;auto-generated /&gt;%0anamespace $(ModInfoNamespace)%0a{%0a    public partial class $(ModInfoClass)%0a    {%0a        public const string CompanyName = "$(ThunderstoreAuthor)"%3b%0a        public const string ModName = "$(BepInPluginName)"%3b%0a        public const string Version = "$(Version)"%3b%0a        public const string GUID = "$(BepInGuid)"%3b%0a    }%0a}</_ModInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(ModInfoGeneratedFile)" Lines="$(_ModInfoContent)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(ModInfoGeneratedFile)" />
    </ItemGroup>
  </Target>

  <!-- Consumer mods compile against Libs but must not ship Libs or ServerSync beside their own DLL. -->
  <Target Name="StripLeakedServerSync"
          AfterTargets="Build"
          Condition="'$(EmbedServerSync)' != 'true'">
    <Delete Files="$(TargetDir)ServerSync.dll" Condition="Exists('$(TargetDir)ServerSync.dll')" />
    <Delete Files="$(TargetDir)DrakeModsLibs.dll" Condition="Exists('$(TargetDir)DrakeModsLibs.dll')" />
    <Delete Files="$(TargetDir)DrakeModsLibs.pdb" Condition="Exists('$(TargetDir)DrakeModsLibs.pdb')" />
  </Target>

  <!-- Fail the build if ServerSync leaked into a consumer mod output or deploy folder. -->
  <Target Name="VerifyNoEmbeddedServerSync"
          AfterTargets="$(DeployAfterTargets)"
          DependsOnTargets="StripLeakedServerSync"
          Condition="'$(EmbedServerSync)' != 'true' and Exists('$(TargetPath)')">
    <Error Condition="Exists('$(TargetDir)ServerSync.dll')"
           Text="ServerSync.dll was copied to $(TargetDir). Consumer mods must not reference ServerSync directly; use DrakeModsLibs only." />
    <Error Condition="Exists('$(R2ModDeployPath)\ServerSync.dll')"
           Text="ServerSync.dll was deployed to $(R2ModDeployPath). Only DrakeModsLibs may ship ServerSync." />
    <Error Condition="Exists('$(GaleModDeployPath)\ServerSync.dll')"
           Text="ServerSync.dll was deployed to $(GaleModDeployPath). Only DrakeModsLibs may ship ServerSync." />
    <Error Condition="'$(VerifyNoServerSyncScript)' == '' or !Exists('$(VerifyNoServerSyncScript)')"
           Text="Verify-NoServerSyncInModDll.ps1 not found. Run scripts\Sync-ModBuild.ps1 or ensure build\scripts\ exists." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(VerifyNoServerSyncScript)&quot; -DllPath &quot;$(TargetPath)&quot;"
          Condition="'$(VerifyNoServerSyncScript)' != '' and Exists('$(VerifyNoServerSyncScript)')"
          IgnoreExitCode="false" />
  </Target>

  <!-- Deploy built mod DLL (+ optional content) to r2modman profile plugins folder. -->
  <Target Name="CopyToR2Profile"
          DependsOnTargets="VerifyNoEmbeddedServerSync"
          AfterTargets="$(DeployAfterTargets)"
          Condition="'$(R2ModDeployPath)' != '' and ('$(DeployViaThunderstoreZip)' != 'true' or '$(SkipPackageMod)' == 'true')"
          Inputs="$(TargetPath)"
          Outputs="$(R2ModDeployPath)\$(TargetFileName)">
    <MakeDir Directories="$(R2ModDeployPath)" />
    <MakeDir Directories="$(R2ModDeployPath)\Assets\Localization" Condition="'@(LocalizationJson)' != ''" />
    <MakeDir Directories="$(R2ModDeployPath)\Assets\Icons" Condition="'@(PaperIcon)' != ''" />
    <MakeDir Directories="$(R2ModDeployPath)\Assets\Items" Condition="'@(PaperForgeAssets)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(R2ModDeployPath)\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(LocalizationJson)"
          DestinationFolder="$(R2ModDeployPath)\Assets\Localization"
          SkipUnchangedFiles="true"
          Condition="'@(LocalizationJson)' != ''" />
    <Copy SourceFiles="@(PaperIcon)"
          DestinationFolder="$(R2ModDeployPath)\Assets\Icons"
          SkipUnchangedFiles="true"
          Condition="'@(PaperIcon)' != ''" />
    <Copy SourceFiles="@(PaperForgeAssets)"
          DestinationFiles="@(PaperForgeAssets->'$(R2ModDeployPath)\Assets\Items\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PaperForgeAssets)' != ''" />
    <Copy SourceFiles="$(TargetDir)README.md" DestinationFiles="$(R2ModDeployPath)\README.md" Condition="Exists('$(TargetDir)README.md')" />
    <Copy SourceFiles="$(TargetDir)icon.png" DestinationFiles="$(R2ModDeployPath)\icon.png" Condition="Exists('$(TargetDir)icon.png')" />
    <Copy SourceFiles="$(TargetDir)CHANGELOG.md" DestinationFiles="$(R2ModDeployPath)\CHANGELOG.md" Condition="Exists('$(TargetDir)CHANGELOG.md')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -&gt; $(R2ModDeployPath)" />
  </Target>

  <!-- Same deploy to Gale profile (same ProfileName / plugin folder layout). -->
  <Target Name="CopyToGaleProfile"
          DependsOnTargets="VerifyNoEmbeddedServerSync"
          AfterTargets="$(DeployAfterTargets)"
          Condition="'$(GaleModDeployPath)' != '' and ('$(DeployViaThunderstoreZip)' != 'true' or '$(SkipPackageMod)' == 'true')"
          Inputs="$(TargetPath)"
          Outputs="$(GaleModDeployPath)\$(TargetFileName)">
    <MakeDir Directories="$(GaleModDeployPath)" />
    <MakeDir Directories="$(GaleModDeployPath)\Assets\Localization" Condition="'@(LocalizationJson)' != ''" />
    <MakeDir Directories="$(GaleModDeployPath)\Assets\Icons" Condition="'@(PaperIcon)' != ''" />
    <MakeDir Directories="$(GaleModDeployPath)\Assets\Items" Condition="'@(PaperForgeAssets)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GaleModDeployPath)\" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(LocalizationJson)"
          DestinationFolder="$(GaleModDeployPath)\Assets\Localization"
          SkipUnchangedFiles="true"
          Condition="'@(LocalizationJson)' != ''" />
    <Copy SourceFiles="@(PaperIcon)"
          DestinationFolder="$(GaleModDeployPath)\Assets\Icons"
          SkipUnchangedFiles="true"
          Condition="'@(PaperIcon)' != ''" />
    <Copy SourceFiles="@(PaperForgeAssets)"
          DestinationFiles="@(PaperForgeAssets->'$(GaleModDeployPath)\Assets\Items\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PaperForgeAssets)' != ''" />
    <Copy SourceFiles="$(TargetDir)README.md" DestinationFiles="$(GaleModDeployPath)\README.md" Condition="Exists('$(TargetDir)README.md')" />
    <Copy SourceFiles="$(TargetDir)icon.png" DestinationFiles="$(GaleModDeployPath)\icon.png" Condition="Exists('$(TargetDir)icon.png')" />
    <Copy SourceFiles="$(TargetDir)CHANGELOG.md" DestinationFiles="$(GaleModDeployPath)\CHANGELOG.md" Condition="Exists('$(TargetDir)CHANGELOG.md')" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -&gt; $(GaleModDeployPath)" />
  </Target>

  <!-- Register or refresh this mod in the r2modman profile mods.yml (simulates a Thunderstore install). -->
  <Target Name="UpdateR2ModProfile"
          AfterTargets="DeployThunderstoreZipToProfiles;CopyToR2Profile"
          DependsOnTargets="PrepareModPackageMetadata;ComposeThunderstoreDependencies"
          Condition="'$(UpdateR2ModsYml)' == 'true' and '$(R2ModsYmlPath)' != '' and Exists('$(R2ModProfileModScript)')">
    <PropertyGroup>
      <_R2ModDescFile>$(IntermediateOutputPath)r2mod-description.txt</_R2ModDescFile>
      <_R2ThunderstoreDeps>@(ThunderstoreDependency, ';')</_R2ThunderstoreDeps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_R2ModDescFile)" Lines="$(Description)" Overwrite="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(R2ModProfileModScript)&quot; -ModsYmlPath &quot;$(R2ModsYmlPath)&quot; -AuthorName &quot;$(ThunderstoreAuthor)&quot; -PackageName &quot;$(ThunderstoreName)&quot; -DisplayName &quot;$(BepInPluginName)&quot; -Version &quot;$(Version)&quot; -DescriptionFile &quot;$(_R2ModDescFile)&quot; -WebsiteUrl &quot;$(WebsiteUrl)&quot; -Dependencies &quot;$(_R2ThunderstoreDeps)&quot;"
          IgnoreExitCode="false" />
    <Message Importance="high" Text="Synced mods.yml: $(ThunderstoreAuthor)-$(ThunderstoreName) ($(Version))" />
  </Target>

  <!-- After PackageMod: install the posix Thunderstore zip into r2modman + Gale (same as a store import). -->
  <Target Name="DeployThunderstoreZipToProfiles"
          AfterTargets="PackageMod"
          DependsOnTargets="ResolveThunderstorePaths"
          Condition="'$(DeployViaThunderstoreZip)' == 'true' and '$(SkipPackageMod)' != 'true' and '$(InstallThunderstoreZipScript)' != '' and Exists('$(InstallThunderstoreZipScript)') and Exists('$(ZipOutput)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(InstallThunderstoreZipScript)&quot; -ZipPath &quot;$(ZipOutput)&quot; -DestDir &quot;$(R2ModDeployPath)&quot;"
          Condition="'$(R2ModDeployPath)' != ''" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(InstallThunderstoreZipScript)&quot; -ZipPath &quot;$(ZipOutput)&quot; -DestDir &quot;$(GaleModDeployPath)&quot;"
          Condition="'$(GaleModDeployPath)' != ''" />
    <Message Importance="high" Text="Deployed Thunderstore zip $(ZipOutput) -&gt; profile plugin folders" />
  </Target>

  <Target Name="WriteThunderstoreManifest" DependsOnTargets="ComposeThunderstoreDependencies;ResolveThunderstorePaths">
    <PropertyGroup>
      <_ManifestDir Condition="'$(ThunderstoreManifestDir)' != ''">$(ThunderstoreManifestDir)</_ManifestDir>
      <_ManifestDir Condition="'$(_ManifestDir)' == ''">$(ThunderstoreFolder)</_ManifestDir>
      <_ManifestPath>$(_ManifestDir)\manifest.json</_ManifestPath>
      <_ManifestContent>{&#xD;&#xA;    "name": "$(ThunderstoreName)",&#xD;&#xA;    "version_number": "$(Version)",&#xD;&#xA;    "author": "$(ThunderstoreAuthor)",&#xD;&#xA;    "description": "$(Description)",&#xD;&#xA;    "website_url": "$(WebsiteUrl)",&#xD;&#xA;    "dependencies": [ $(ThunderstoreDependenciesJson) ]&#xD;&#xA;}</_ManifestContent>
    </PropertyGroup>
    <MakeDir Directories="$(_ManifestDir)" />
    <WriteLinesToFile File="$(_ManifestPath)" Lines="$(_ManifestContent)" Overwrite="true" />
  </Target>
</Project>
