{
  "name": "DrakeModsLibs-ReskinIt-ItemShop",
  "description": "Reskinned items in shops: the look (icon, model, colours) travels with the item and shows on display.",
  "requireMods": [
    {
      "guid": "com.drakemods.reskinit",
      "minVersion": "0.1.0"
    },
    {
      "guid": "com.drakemods.itemshop",
      "minVersion": "0.1.0"
    }
  ],
  "configOverrides": [
    {
      "guid": "com.drakemods.reskinit",
      "section": "02 - Admin",
      "key": "AdminSource",
      "value": "Own"
    },
    {
      "guid": "com.drakemods.reskinit",
      "section": "02 - Admin",
      "key": "AllowAdminOverride",
      "value": "false"
    },
    {
      "guid": "com.drakemods.reskinit",
      "section": "03 - Features",
      "key": "RequireDiscovery",
      "value": "Off"
    },
    {
      "guid": "com.drakemods.reskinit",
      "section": "03 - Features",
      "key": "ProgressionGate",
      "value": "false"
    },
    {
      "guid": "com.drakemods.reskinit",
      "section": "05 - Cost",
      "key": "CostEnabled",
      "value": "false"
    },
    {
      "guid": "com.drakemods.reskinit",
      "section": "04 - Exclusions",
      "key": "ExclusionSource",
      "value": "Own"
    }
  ],
  "setup": {
    "timeOfDay": 0.5,
    "freezeTime": 1,
    "god": 1,
    "noBuild": "off",
    "hideUnlockPopups": 1
  },
  "resetBetweenTests": true
}