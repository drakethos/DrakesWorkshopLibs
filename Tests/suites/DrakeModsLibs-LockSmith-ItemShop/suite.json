    },
    {
      "guid": "com.drakesworkshop.locksmith",
      "section": "02 Features",
      "key": "EnableOptInAccess",
      "value": "true"
    },
    {
      "guid": "com.drakesworkshop.locksmith",
      "section": "02 Features",
      "key": "EnablePieceGuests",
      "value": "true"
